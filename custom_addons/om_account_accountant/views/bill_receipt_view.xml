<?xml version="1.0" encoding="utf-8"?>

<odoo>
<record id="view_account_move_form_inherit_receipt_no" model="ir.ui.view">
    <field name="name">account.move.form.inherit.receipt.no</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form" />
    <field name="arch" type="xml">
        <!-- XPath to target the Bill Reference field -->
        <xpath expr="//field[@name='ref']" position="after">
            <!-- Adding the Receipt No field below Bill Reference -->
<!--            <div class="o_cell o_wrap_label text-break text-900" style="">-->
<!--                <label class="o_form_label" for="ref_0">Bill Reference</label></div>-->
            <div class="o_cell o_wrap_label text-break text-900" style="flex">
                <label class="o_form_label" style="bold" for="receipt_no">Receipt No</label>
            </div>
                <div class="o_cell" style="">
                    <div name="ref" class="o_field_widget o_field_char">
                    <field name="receipt_no" placeholder="Enter Receipt No" />
                    <div class="o_field_char_buttons position-absolute d-inline"> </div>
                    </div>
                </div>

        </xpath>
    </field>
</record>



</odoo>