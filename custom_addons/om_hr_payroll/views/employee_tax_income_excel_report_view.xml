<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <data>
        <template id="employee_tax_income_report">
            <t t-call="web.external_layout">
                 <div>
                    <button type="button" style="background-color: #007bff;  padding: 10px 20px; border: none; border-radius: 4px; display: inline-block; font-size: 14px; cursor: pointer; margin-bottom: 15px;" class="btn btn-primary" >
                        <a t-att-href="url" style="text-decoration: none; color:white"  target="blank">
                            Export to Excel
                        </a>
                    </button>
                </div>

                <div class="page">
                                        <style>
                             body {
                                margin: 0;
                                padding: 5px;
                                width: 1000px;
                                margin: 0 auto;
                                border: 1px solid black;
                            }
                            main{
                            margin-bottom:50px;
                            }
                            .o_company_logo_small{
                            display:none;
                            }

                            .list-unstyled{
                            display:none;
                            }
                            .me-2{
                            display:none;
                            }
                            table {
                                width: 100%;
                                border-collapse: collapse;
                            }
                            th {
                                font-weight: bold;
                                font-size:15px;
                                border-left: 1px solid black;
                            }
                            td {
                                text-align: left;
                                font-size:15px;
                                border-left: 1px solid black;
                                border-top: 1px solid black;
                            }
                            p{
                            margin:0;
                            font-weight: 700;
                            font-size: 15px;
                            }
                        </style>
                    <t t-if="len(employees) == 0">
                        <main>
                            <h3>No Employees In The Selected Period</h3>
                        </main>
                    </t>
                    <t t-foreach="employees" t-as="line">
                    <main>
                        <div style=" border: 1px solid black;display:flex;font-weight:bold;padding:0px 15px">
                        <div style="width:50%; display:flex; padding:5px 0 ">
                            <img t-att-src="image_data_uri(company.logo_web)"  style="width: 130px; height:90px"/>
                            <div style="width:70%; text-align:center; padding:10px 0">
                                <span t-esc="company['name']"/>
                            </div>
                        </div>
                        <div style="width:50%; border-left:1px solid black; text-align:center; display:flex; justify-content:center; align-items:center; flex-direction:column;">
                            <div>Salary tax Income Sheet </div>
                            <div style="font-size:10px; align-self:end; font-weight:normal; width:100%; text-align:right;"><span t-esc="month"/></div>
                        </div>
                        </div>

                        <div style="font-weight:bold;margin:35px 0px;"> </div>

<!--                         <span t-esc="period"/>-->
                        <table style="width: 95%; border: 1px solid black; border-left:0;">
                        <tr style="border-left:1px solid black;background-color: #D3D3D3;">
                            <th>Employee's Tin</th>
                            <th>Employee's Name</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Basic Salary</th>
                            <th>Transport Allowance</th>
                            <th>Taxable Transport Allowance</th>
                            <th>Over Time</th>
                            <th>Other Taxable Benefit</th>
                            <th>Total Taxable Income</th>
                            <th>Tax Withheld</th>
                            <th>Cost Sharing</th>


                        </tr>
                        <t t-foreach="line" t-as="employee">
                            <tr style="border-left:1px solid black;">
                              <td><t t-esc="employee['employee_tin']"/></td>
                    <td><t t-esc="employee['employee_name']"/></td>
                    <td><t t-esc="employee['contract_start_date']"/></td>
                    <td> </td>

                    <td><t t-esc="employee['basic_salary']"/></td>
                    <td> </td>
                    <td><t t-esc="employee['transport_allowance']"/></td>
                    <td><t t-esc="employee['taxable_transport_allowance']"/></td>
                    <td> </td>
                    <td><t t-esc="employee['other_taxable_benefit']"/></td>
                    <td><t t-esc="employee['total_taxable_income']"/></td>
                    <td><t t-esc="employee['tax_withheld']"/></td>
                    <td> </td>


                            </tr>
                        </t>
                    </table>
                    </main>
                    <div class="" style=" text-align: center; margin-top: auto; padding: 10px 20px;">
                        <div style="display:flex; justify-content: end; margin-top:1px; font-size:12px;">
                            <div style="font-weight:400;">Page <span t-esc="line_index + 1"/> of <span t-esc="len(employees)"/></div>
                        </div>
                    </div>

                        <p style="page-break-before:always;"> </p>
                    </t>
                </div>

            </t>
        </template>


    </data>
</odoo>
